# Copy this file to `.env` and fill in values as each milestone needs them.
# `.env` is gitignored — real keys never get committed.

# Household owner's name (anyone can talk to the assistant; this just tells
# it who it primarily serves).
OWNER_NAME=Will
# What the assistant calls itself.
ASSISTANT_NAME=Alexa

# ── Milestone 1: Home Assistant ──────────────────────────────────────────────
# HAOS runs in the Hyper-V VM (scripts/setup_haos_vm.ps1); use its address.
# Create the token in HA: click your user (bottom-left) → Security tab →
# Long-lived access tokens → Create token. It is shown ONCE — paste it here.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# IANA timezone for the HA container (docker-compose reads this file too).
TZ=America/New_York

# ── Milestone 2: LLM with tool use ───────────────────────────────────────────
# Set at least one key. LLM_PROVIDER picks which adapter is active.
ANTHROPIC_API_KEY=
# Only for identity-linked keys (the API demands it with a 400 if missing):
# Console → Settings → Workspaces → copy the wrkspc_... id.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Thinking depth for commands: low = snappy/cheap, high = deeper reasoning.
LLM_EFFORT=low

# ── Milestone 3: wake word + speech-to-text ──────────────────────────────────
# Wake word is openWakeWord — local, no API key. Either a pretrained name
# (alexa, hey_jarvis, hey_mycroft, hey_rhasspy) or a path to your own trained
# model (docs/custom-wake-word.md), e.g. WAKE_MODEL=models/hey_gary.onnx
WAKE_MODEL=alexa
# Tune with scripts/m3_spike.py --monitor: raise if false wakes, lower if missed.
WAKE_THRESHOLD=0.5
# "" = default mic. Otherwise a device index or name substring
# (list them: uv run scripts/m3_spike.py --devices)
AUDIO_INPUT_DEVICE=
# Deepgram: https://console.deepgram.com — signup includes ~$200 free credit.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# If it ends your turn while you're mid-thought, raise this toward 0.85
# (0 = Deepgram's default). Higher = waits for more confidence you're done.
STT_EOT_THRESHOLD=0

# ── Milestone 4: voice engines ───────────────────────────────────────────────
# Primary: OpenAI Realtime engine (speech-native, uses OPENAI_API_KEY above).
REALTIME_MODEL=gpt-realtime-2.1
# "sol" is currently org-gated: the engine auto-falls-back to marin and will
# pick sol up the day OpenAI unlocks it. Others: cedar, alloy, ash, ballad,
# coral, echo, sage, shimmer, verse.
REALTIME_VOICE=sol
# How fast it decides you're done talking: low|medium|high|auto.
# high = snappy; drop toward auto if it cuts off your thinking pauses.
REALTIME_EAGERNESS=high
# A silent open session auto-closes after this (realtime bills by the minute).
REALTIME_IDLE_TIMEOUT_S=20
# Interrupt by just talking (no wake phrase). HEADPHONES ONLY — on open
# speakers the mic hears the assistant's own voice and chaos ensues.
REALTIME_TALK_OVER=false

# Alternate engine (ElevenLabs pipeline; custom voice — parked for now).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
