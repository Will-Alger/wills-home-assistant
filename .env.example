# Copy this file to `.env` and fill in values as each milestone needs them.
# `.env` is gitignored — real keys never get committed.

# Household owner's name (anyone can talk to the assistant; this just tells
# it who it primarily serves).
OWNER_NAME=Will
# What the assistant calls itself.
ASSISTANT_NAME=Alexa
# Your personal style knob: free-text lines appended to her instructions.
# e.g. "Be extremely brief." or "Dry humor welcome."
ASSISTANT_EXTRA_INSTRUCTIONS=

# ── Milestone 1: Home Assistant ──────────────────────────────────────────────
# HAOS runs in the Hyper-V VM (scripts/setup_haos_vm.ps1). New HAOS installs
# (2026.8+) serve on port 80 — no :8123. Use the VM's IP (HA → Settings →
# System → Network); Python can't always resolve homeassistant.local.
# Create the token in HA: click your user (bottom-left) → Security tab →
# Long-lived access tokens → Create token. It is shown ONCE — paste it here.
HA_URL=http://192.168.1.x
HA_TOKEN=

# IANA timezone for the HA container (docker-compose reads this file too).
TZ=America/New_York

# Background Claude jobs (reflection; later, dispatched coding work) run via
# the Claude Code CLI — billed to your Claude Max SUBSCRIPTION, $0 API cost.
# Set false to use the API key instead.
USE_CLAUDE_SUBSCRIPTION=true

# Coding agents she commissions run on this Claude model alias (opus, sonnet,
# fable) with an optional effort level (low|medium|high|xhigh|max).
DISPATCH_MODEL=opus
DISPATCH_EFFORT=
# A build is killed after this many seconds; one that dies without a result
# (usually the Max usage window) is resumed once after this delay.
DISPATCH_TIMEOUT_S=3600
DISPATCH_RESUME_DELAY_S=300
# Her deeper reasoning (the `think` tool): Claude model alias + optional effort,
# via the CLI on your Max subscription. The voice model stays the voice.
BRAIN_MODEL=opus
BRAIN_EFFORT=
# She speaks up on her own when a build finishes, hits a milestone, or rolls
# back. Normal announcements wait out quiet hours ("" = never quiet); urgent
# ones don't. Each is retried with backoff up to this many times.
ANNOUNCE_QUIET_HOURS=23:00-08:00
ANNOUNCE_MAX_ATTEMPTS=4
# Staging ("switch to task 7") syncs the branch's dependencies with uv, and the
# merge gates run lint/tests behind it. Leave blank to find uv on PATH or in its
# WinGet install folder; with no uv at all the gates fall back to python -m.
UV_EXE=
# Web search rides OpenAI's Responses API (same OPENAI_API_KEY): the model
# that reads the results and how much page context it pulls (low|medium|high).
WEB_SEARCH_MODEL=gpt-4.1-mini
WEB_SEARCH_CONTEXT=low

# ── Milestone 11: asynchronous communication ─────────────────────────────────
# Presence: the Home Assistant person entity fed by the companion app's GPS
# (e.g. person.will). Empty = untracked (she assumes you're home). Debounce:
# home after ARRIVE_S, away after LEAVE_S; SETTLE_S is the grace after arriving
# before the welcome ("while you were out…") is spoken.
PRESENCE_ENTITY=
PRESENCE_ARRIVE_S=60
PRESENCE_LEAVE_S=300
PRESENCE_SETTLE_S=90
# The phone: a companion-app notify service name WITHOUT the domain
# (Developer Tools → Actions lists notify.mobile_app_<phone>). Empty = no
# phone channel. Cards carry buttons (Approve & merge, Answer, Yes/No, Got it)
# whose taps come back over the websocket and act like spoken commands.
PHONE_NOTIFY_SERVICE=
# While you're away, normal notifications of these kinds go to the phone
# (urgent ones always do); the rest wait for the arrival welcome.
PUSH_WHILE_AWAY_KINDS=task,question,watch,thought,system,followup
# Spoken-but-unheard items go to the phone (silently) after this many hours;
# unread items expire after this many days; a built task nobody touched for
# this many days gets an inbox-only "still want it?"; a calendar meeting in
# progress holds normal news (urgent still comes through, to the phone).
ESCALATE_AFTER_H=4
UNREAD_EXPIRE_DAYS=3
NUDGE_AFTER_DAYS=2
FOCUS_FROM_CALENDAR=true
# Her journal (what she did and saw, one small file per day in data/journal/)
# is pruned after this many days.
JOURNAL_KEEP_DAYS=90

# ── Milestone 2: LLM with tool use ───────────────────────────────────────────
# Set at least one key. LLM_PROVIDER picks which adapter is active.
ANTHROPIC_API_KEY=
# Only for identity-linked keys (the API demands it with a 400 if missing):
# Console → Settings → Workspaces → copy the wrkspc_... id.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Thinking depth for commands: low = snappy/cheap, high = deeper reasoning.
LLM_EFFORT=low

# ── Milestone 3: wake word + speech-to-text ──────────────────────────────────
# Wake word is openWakeWord — local, no API key. Either a pretrained name
# (alexa, hey_jarvis, hey_mycroft, hey_rhasspy) or a path to your own trained
# model. Note: "alexa" also fires inside "Hey Alexa" — to REQUIRE the "hey",
# train a custom hey_alexa model (docs/custom-wake-word.md, ~1h in Colab).
WAKE_MODEL=alexa
# Tune with scripts/m3_spike.py --monitor: raise if false wakes, lower if missed.
WAKE_THRESHOLD=0.5
# openWakeWord's bundled Silero speech gate: the wake word only counts when the
# frame sounds like speech, so a vacuum cleaner or a TV cannot wake her. 0 = off.
# Two false wakes inside three minutes also raise the bar by 0.15 for ten.
WAKE_VAD_THRESHOLD=0.5
# How she answers the wake word (and a push-to-talk press), before the session
# has even connected: voice = one of the short clips rendered in her own voice
# under assets/voice/ack ("Yes?", "Go ahead.", "Morning." — never the same one
# twice in a row); ding = the rising chime this used to be; off = silence.
# The frames of that moment are flagged so her own echo is dropped and the
# command you say right over her still lands. "voice" also replaces the other
# dings with her lines (assets/voice/cue: "Mm-hm." when your turn is over,
# "One moment." / "Still on it." under a slow tool, "Sorry, something went
# wrong." on a failure; the re-listen ding and the goodbye chime fall silent).
# Re-render with scripts/render_acks.py and --cues (a few cents, once); a
# missing clip falls back to its tone and says so at boot.
WAKE_ACK=voice
# "" = default mic. Otherwise a device index or name substring
# (list them: uv run scripts/m3_spike.py --devices)
AUDIO_INPUT_DEVICE=
# Speaker: "" = system default; an index or a name fragment ("airpods"). Both
# can also be switched (and saved) from the Settings panel or by voice —
# "use my AirPods" — and that choice wins over these lines at every start.
AUDIO_OUTPUT_DEVICE=
# Deepgram: https://console.deepgram.com — signup includes ~$200 free credit.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# If it ends your turn while you're mid-thought, raise this toward 0.85
# (0 = Deepgram's default). Higher = waits for more confidence you're done.
STT_EOT_THRESHOLD=0

# ── Milestone 4: voice engines ───────────────────────────────────────────────
# Primary: OpenAI Realtime engine (speech-native, uses OPENAI_API_KEY above).
REALTIME_MODEL=gpt-realtime-2.1-mini
# "sol" is currently org-gated: the engine auto-falls-back to marin and will
# pick sol up the day OpenAI unlocks it. Others: cedar, alloy, ash, ballad,
# coral, echo, sage, shimmer, verse.
REALTIME_VOICE=sol
# How fast semantic turn detection decides you're done: low|medium|high|auto.
# auto (= medium) waits while a sentence sounds unfinished; high cut sentences
# off mid-thought.
REALTIME_EAGERNESS=auto
# A silent open session auto-closes after this and returns to wake-word idle
# (open sessions bill by the minute). Raise it if quiet moments cut you off.
REALTIME_IDLE_TIMEOUT_S=45
# One-shot close timing: a lone command closes this many seconds after the
# spoken confirmation; a lone answered question gets the longer window for
# follow-ups. Speaking again cancels either.
REALTIME_COMMAND_CLOSE_S=8
REALTIME_INFO_CLOSE_S=15
# Interrupt by just talking (no wake phrase). HEADPHONES ONLY — on open
# speakers the mic hears the assistant's own voice and chaos ensues.
REALTIME_TALK_OVER=false
# Loudspeaker talk-over, tentatively: while she speaks, a sustained rise of
# the mic above her own echo holds playback and lets the server's speech
# detection confirm (she stops) or, within 1.5 s, resume where she paused.
REALTIME_TENTATIVE_INTERRUPT=true
# Server-side noise reduction before VAD: far_field (desk mic), near_field
# (headset), or empty for none (the default — a trial, not yet validated).
REALTIME_NOISE_REDUCTION=
# Who decides your turn has ended. semantic_vad (default) waits while a
# sentence sounds unfinished, at the REALTIME_EAGERNESS above; server_vad ends
# it on SILENCE only, after REALTIME_SILENCE_MS — predictable, but any pause to
# think ends the turn. "let me think" widens either one for a while.
REALTIME_TURN_DETECTION=semantic_vad
REALTIME_SILENCE_MS=1000
# Send the server speech or clean silence, never the room: a local gate on the
# microphone keeps a vacuum cleaner, the fridge and her own tail from ever
# becoming a "turn". false = stream the raw microphone.
REALTIME_SPEECH_GATE=true
# Push to talk: hold this hotkey anywhere on the desktop and speak; letting
# go ends the turn. Turn detection is OFF while it is held, so a pause never
# cuts you off, and she stops listening the instant you let go. Modifier-only
# by default (Ctrl+Alt means nothing to the app you're typing in, and the
# keys are never swallowed). Combine with + : ctrl, alt, shift, win, space,
# a letter, a digit, f1-f24. Blank or "off" = wake word only. Windows only;
# no admin needed, but a press inside an ELEVATED window isn't seen.
PTT_HOTKEY=ctrl+alt

# ── Milestone 6: Apple Calendar (iCloud CalDAV) ──────────────────────────────
# Leave both blank and the calendar tools stay hidden from the assistant.
# The password MUST be an app-specific one: appleid.apple.com → Sign-In and
# Security → App-Specific Passwords → generate one for "Alexa". Your Apple ID
# password is rejected, and 2FA prompts can't reach a headless assistant.
# Verify the link before asking by voice:
#   uv run scripts/check_calendar.py --write-test
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Which calendar she reads and writes by default. "" = the account's first
# one; check_calendar.py prints the names.
ICLOUD_CALENDAR_NAME=
# Only change if you point her at a non-iCloud CalDAV server.
ICLOUD_CALDAV_URL=https://caldav.icloud.com

# Alternate engine (ElevenLabs pipeline; custom voice — parked for now).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
